# claude-box settings. install.sh copies this to .env (not committed); edit .env.
# Format: KEY=value, one per line. ~ and $HOME are expanded. Lists use ":" between paths.

# --- claude-box options ------------------------------------------------------
# Extra folders mounted READ-WRITE in every project (caches that can be re-downloaded)
CLAUDE_BOX_RW=~/.cache/huggingface
# Extra folders mounted READ-ONLY in every project (shared datasets, reference code)
CLAUDE_BOX_RO=
# GPUs to pass (e.g. all, device=0). Empty = no GPU
CLAUDE_BOX_GPUS=
# Mount targets of symlinks found in the repo, read-only (1/0)
CLAUDE_BOX_AUTO_MOUNTS=1

# --- Environment variables inside the box -----------------------------------
# Any other KEY=value line is set inside the box.
# A bare KEY (no "=") passes the host's current value, e.g. a token exported in ~/.bashrc.
HF_HOME=~/.cache/huggingface
# TORCH_HOME=~/.cache/torch
# WANDB_API_KEY
