#!/usr/bin/env bash
# claude-box: run Claude Code in a rootless Docker container that can only
# write to the current git repo (plus any --add-dir folders, and its own
# state dir ~/.claude-box).
#
# Usage:
#   claude-box [claude args...]          start Claude Code in the current repo
#   claude-box --add-dir ../other-repo   also give read-write access to another folder
#   claude-box shell [--add-dir ...]     open a bash shell in the same container setup
#   claude-box mounts [--add-dir ...]    show what the box would have access to, and exit
#
# Environment variables:
#   CLAUDE_BOX_GPUS=all           pass GPUs (any value accepted by docker --gpus)
#   CLAUDE_BOX_AUTO_MOUNTS=0      disable automatic mounting of symlink targets
#   CLAUDE_BOX_DRY_RUN=1          print the docker command instead of running it
#   CLAUDE_BOX_CONTEXT            docker context (default: rootless)
#   CLAUDE_BOX_IMAGE              image name (default: claude-box)
#   CLAUDE_BOX_HOME               state dir (default: ~/.claude-box)
set -euo pipefail

CONTEXT="${CLAUDE_BOX_CONTEXT:-rootless}"
IMAGE="${CLAUDE_BOX_IMAGE:-claude-box}"
BOX_HOME="${CLAUDE_BOX_HOME:-$HOME/.claude-box}"
DRY_RUN="${CLAUDE_BOX_DRY_RUN:-0}"

die() { echo "claude-box: $*" >&2; exit 1; }

MODE=claude
case "${1:-}" in
  -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  shell) MODE=shell; shift ;;
  mounts) MODE=mounts; shift ;;
esac

# Refuse folders that would expose far too much read-write
check_rw() {
  case "$1" in
    /|"$HOME"|"$(dirname "$HOME")") die "refusing to mount '$1' read-write; use a project folder." ;;
  esac
}

# --- Read-write folders: the current repo + every --add-dir ------------------
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
ROOT="$(readlink -f "$ROOT")"
check_rw "$ROOT"
RW_DIRS=("$ROOT")

add_rw() {
  local d
  [[ -d "$1" ]] || die "--add-dir: '$1' is not a directory"
  d="$(readlink -f "$1")"
  check_rw "$d"
  RW_DIRS+=("$d")
  ARGS+=("$d")
}

ARGS=()
while (( $# )); do
  case "$1" in
    --add-dir=*) ARGS+=(--add-dir); add_rw "${1#--add-dir=}"; shift ;;
    --add-dir)
      shift; ARGS+=(--add-dir)
      (( $# )) && [[ "$1" != -* ]] || die "--add-dir needs at least one folder"
      while (( $# )) && [[ "$1" != -* ]]; do add_rw "$1"; shift; done ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

inside_rw() {
  local p="$1" d
  for d in "${RW_DIRS[@]}"; do
    [[ "$p" == "$d" || "$p" == "$d"/* ]] && return 0
  done
  return 1
}

if [[ "$DRY_RUN" != 1 && "$MODE" != mounts ]] && ! docker context inspect "$CONTEXT" >/dev/null 2>&1; then
  die "docker context '$CONTEXT' not found. Install rootless Docker first (see README)."
fi

mkdir -p "$BOX_HOME"

# --- Read-only mounts ---------------------------------------------------------
declare -A SEEN=()
RO=()
add_ro() {
  local p="$1"
  [[ -n "$p" && -e "$p" && "$p" != "/" ]] || return 0
  inside_rw "$p" && return 0            # already mounted read-write
  [[ -n "${SEEN[$p]:-}" ]] && return 0
  SEEN[$p]=1
  RO+=(-v "$p:$p:ro")
}

for d in "${RW_DIRS[@]}"; do
  # 1) Explicit list: one path per line in <folder>/.claude-box.mounts (# comments ok)
  if [[ -f "$d/.claude-box.mounts" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"; line="${line%"${line##*[![:space:]]}"}"
      [[ -z "$line" ]] && continue
      line="${line/#\~/$HOME}"
      [[ "$line" == /* ]] || line="$d/$line"
      [[ -e "$line" ]] || { echo "claude-box: warning: '$line' does not exist, skipped" >&2; continue; }
      add_ro "$(readlink -f "$line")"
    done < "$d/.claude-box.mounts"
  fi

  # 2) Automatic: targets of symlinks inside the folder that point outside of it
  if [[ "${CLAUDE_BOX_AUTO_MOUNTS:-1}" == 1 ]]; then
    while IFS= read -r -d '' link; do
      target="$(readlink -f "$link" 2>/dev/null)" || continue
      [[ -e "$target" ]] || continue
      [[ -d "$target" ]] || target="$(dirname "$target")"
      add_ro "$target"
    done < <(find "$d" \( -name .git -o -name .venv -o -name node_modules -o -name __pycache__ \) -prune \
               -o -type l -print0 2>/dev/null)
  fi
done

if (( ${#RO[@]} / 2 > 30 )); then
  echo "claude-box: warning: $(( ${#RO[@]} / 2 )) read-only mounts. Consider listing parent folders in .claude-box.mounts" >&2
  echo "            and setting CLAUDE_BOX_AUTO_MOUNTS=0." >&2
fi

if [[ "$MODE" == mounts ]]; then
  echo "Read-write:"
  for d in "${RW_DIRS[@]}"; do echo "  $d"; done
  echo "  $BOX_HOME  (Claude login, uv cache, venvs; seen as /box)"
  echo "Read-only:"
  for (( i=1; i<${#RO[@]}; i+=2 )); do echo "  ${RO[i]%%:*}"; done
  [[ -f "$HOME/.gitconfig" ]] && echo "  $HOME/.gitconfig  (seen as /etc/gitconfig)"
  echo "Everything else on the server: not visible."
  exit 0
fi

# --- Other options ------------------------------------------------------------
RW=()
for d in "${RW_DIRS[@]}"; do RW+=(-v "$d:$d"); done

EXTRA=()
[[ -n "${CLAUDE_BOX_GPUS:-}" ]] && EXTRA+=(--gpus "$CLAUDE_BOX_GPUS")
[[ -f "$HOME/.gitconfig" ]] && EXTRA+=(-v "$HOME/.gitconfig:/etc/gitconfig:ro")
[[ -t 0 && -t 1 ]] && EXTRA+=(-it)

if [[ "$MODE" == shell ]]; then CMD=(bash); else CMD=(claude "${ARGS[@]}"); fi

# Note: each project gets its own venv under ~/.claude-box/venvs, chosen by the
# uv wrapper inside the image (uv-shim.sh), so host .venv folders are never touched.
DOCKER=(docker --context "$CONTEXT" run --rm --init
  --security-opt no-new-privileges
  --hostname claude-box
  -e HOME=/box
  -e TERM="${TERM:-xterm-256color}"
  -e COLORTERM="${COLORTERM:-}"
  -e UV_CACHE_DIR=/box/.cache/uv
  -e IS_SANDBOX=1
  -v "$BOX_HOME:/box"
  "${RW[@]}"
  -w "$(pwd -P)"
  "${RO[@]}"
  "${EXTRA[@]}"
  "$IMAGE" "${CMD[@]}")

if [[ "$DRY_RUN" == 1 ]]; then
  printf '%q ' "${DOCKER[@]}"; echo
else
  exec "${DOCKER[@]}"
fi
